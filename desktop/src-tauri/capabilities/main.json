{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "windows": ["main"],
  "permissions": [
    "allow-api-request",
    "allow-api-cancel",
    "allow-backend-status",
    "allow-open-repository",
    "allow-open-ocs-docs",
    "allow-pick-download-dir",
    "allow-session-read",
    "allow-session-remember-login",
    "allow-session-remember-task",
    "allow-session-clear",
    "allow-close-prompt-shown",
    "allow-close-choice",
    "allow-preferences-read",
    "allow-preferences-write",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
