# 超星学习通自动化工具 - 配置文件示例
# 使用方法：复制此文件为 config.ini，然后修改下面的配置

[common]
# 手机号（必填）
username = 

# 密码（必填）
password = 

# 是否使用 cookies 登录（可选，设为 true 则忽略账号密码）
use_cookies = false

# 要学习的课程ID列表，多个用逗号分隔（可选，留空则学习全部课程）
# 例如: course_list = 123456,789012
course_list = 

# 视频播放速度（1.0-2.0）
speed = 1.0

# 同时进行的章节数
jobs = 4

# 遇到未开放章节的处理方式: retry-重试, continue-跳过
notopen_action = retry

# 任务失败或未开放章节的重试等待时间（秒）
retry_interval = 1.0


[tiku]
# OCS 题库配置。留空表示不自动答题。
# 填写 JSON 数组，或 http(s) 订阅链接。格式见 https://docs.ocsjs.com/docs/work
config =

# 是否达到覆盖率后自动提交。false 为只保存不提交
submit = false

# 题库覆盖率阈值（0-1），低于此值不提交答案
cover_rate = 0.9

# 每次搜题前的等待秒数
delay = 1

# 是否校验题库 HTTPS 证书（true/false）。仅在确认题库可信且使用自签名证书时改为 false
verify_ssl = true


[notification]
# 通知类型: disable, pushplus, bark, dingtalk, feishu, wechat
type = disable

# PushPlus Token（当 type=pushplus 时）
pushplus_token = 

# Bark 推送地址（当 type=bark 时）
bark_url = 
