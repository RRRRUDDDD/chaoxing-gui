diff --git a/web/src/main.jsx b/web/src/main.jsx
index 54b39dd..3054ceb 100644
--- a/web/src/main.jsx
+++ b/web/src/main.jsx
@@ -3,8 +3,35 @@ import ReactDOM from 'react-dom/client'
 import App from './App.jsx'
 import './index.css'
 
-ReactDOM.createRoot(document.getElementById('root')).render(
-  <React.StrictMode>
-    <App />
-  </React.StrictMode>,
-)
+// P1 占位：Tauri 宿主下未就绪/失败时展示状态页（P2 换 adapter + 启动状态 UI）。
+// 仅在 Tauri 环境（window.__TAURI_INTERNALS__ 存在）时启用，Electron/浏览器不受影响。
+async function bootstrap() {
+  const isTauri = typeof window !== 'undefined' && '__TAURI_INTERNALS__' in window
+  if (isTauri) {
+    try {
+      const { invoke } = window.__TAURI_INTERNALS__
+      const status = await invoke('backend_status')
+      if (status.phase !== 'ready') {
+        ReactDOM.createRoot(document.getElementById('root')).render(
+          <div style={{ fontFamily: 'system-ui', color: '#e2e8f0', background: '#0f172a', minHeight: '100vh', display: 'grid', placeItems: 'center' }}>
+            <div>
+              <h1>后端启动中…</h1>
+              <p>phase: {status.phase}{status.error ? ` · ${status.error}` : ''}</p>
+              <p style={{ opacity: 0.6 }}>此为 P1 临时占位页，P2 将接入正式启动状态。</p>
+            </div>
+          </div>,
+        )
+        return
+      }
+    } catch (err) {
+      console.warn('backend_status 查询失败，继续正常渲染', err)
+    }
+  }
+  ReactDOM.createRoot(document.getElementById('root')).render(
+    <React.StrictMode>
+      <App />
+    </React.StrictMode>,
+  )
+}
+
+bootstrap()
