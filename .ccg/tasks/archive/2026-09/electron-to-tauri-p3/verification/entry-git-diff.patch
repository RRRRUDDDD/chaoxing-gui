+            sys.exit(1)
+
+        # serve_forever 在后台线程，主线程保持存活直至 stdin EOF 触发 os._exit
+        try:
+            while True:
+                time.sleep(1)
+        except KeyboardInterrupt:
+            sys.exit(0)
